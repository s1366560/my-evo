// Prisma schema for My Evo Backend

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User model
model User {
  id         String   @id @default(uuid())
  email      String   @unique
  password   String
  name       String?
  avatar     String?
  role       String   @default("user")
  level      Int      @default(1)
  reputation Float    @default(0)
  credits    Float    @default(0)
  claimed    Boolean  @default(false)
  claimCode  String?  @unique
  claimDeadline DateTime?

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  nodes       Node[]
  maps        Map[]
  assets      Asset[]
  votes       Vote[]
  sessions    Session[]
  passwordResetTokens PasswordResetToken[]
  assetReviews    AssetReview[]
  assetPurchases  AssetPurchase[]

  @@map("users")
}

// Password reset token model
model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([tokenHash])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

// Session model
model Session {
  id           String   @id @default(uuid())
  userId       String
  refreshToken String
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([refreshToken])
  @@map("sessions")
}

// Map model
model Map {
  id          String   @id @default(uuid())
  name        String
  description String?
  ownerId     String
  owner       User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  nodes       Node[]
  edges       Edge[]

  @@index([ownerId])
  @@map("maps")
}

// Node model
model Node {
  id          String   @id @default(uuid())
  name        String
  description String?
  type        String   @default("concept")
  category    String?
  metadata    Json     @default("{}")
  position    Json?
  level       Int      @default(0)
  reputation  Float    @default(0)
  viewCount   Int      @default(0)

  ownerId     String
  owner       User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  mapId       String?
  map         Map?     @relation(fields: [mapId], references: [id], onDelete: SetNull)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  outgoingEdges Edge[]  @relation("SourceNode")
  incomingEdges Edge[]  @relation("TargetNode")
  assets        Asset[]

  @@index([ownerId])
  @@index([mapId])
  @@index([type])
  @@map("nodes")
}

// Edge model
model Edge {
  id          String   @id @default(uuid())
  type        String   @default("related")
  weight      Float    @default(1.0)
  description String?

  sourceId    String
  sourceNode  Node     @relation("SourceNode", fields: [sourceId], references: [id], onDelete: Cascade)

  targetId    String
  targetNode  Node     @relation("TargetNode", fields: [targetId], references: [id], onDelete: Cascade)

  mapId       String?
  map         Map?     @relation(fields: [mapId], references: [id], onDelete: SetNull)

  createdAt   DateTime @default(now())

  @@index([sourceId])
  @@index([targetId])
  @@index([mapId])
  @@map("edges")
}

// Asset model — GEP protocol base (Gene / Capsule / Recipe share this shape)
model Asset {
  id          String   @id @default(uuid())
  title       String
  description String?
  // GEP type: 'Gene' | 'Capsule' | 'Recipe'
  type        String
  // Optional GEP subkind (e.g. 'strategy', 'tool', 'workflow')
  kind        String?
  content     String?
  url         String?
  metadata    Json     @default("{}")
  published   Boolean  @default(false)
  // null = free, >0 = paid asset priced in credits
  price       Float?
  // Lifecycle: 'draft' | 'published' | 'recycled'
  status      String   @default("draft")
  // Currently published version pointer (denormalized for cheap reads)
  publishedVersionId String? @unique
  publishedVersion   AssetVersion? @relation("AssetPublishedVersion", fields: [publishedVersionId], references: [id], onDelete: SetNull)

  authorId    String
  author      User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  nodeId      String?
  node        Node?    @relation(fields: [nodeId], references: [id], onDelete: SetNull)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  votes       Vote[]
  versions    AssetVersion[] @relation("AssetVersions")
  reviews     AssetReview[]
  purchases   AssetPurchase[]

  @@index([authorId])
  @@index([nodeId])
  @@index([type])
  @@index([status])
  @@index([published])
  @@map("assets")
}

// Asset version — immutable snapshot per publish
model AssetVersion {
  id           String   @id @default(uuid())
  assetId      String
  asset        Asset    @relation("AssetVersions", fields: [assetId], references: [id], onDelete: Cascade)
  // Monotonically increasing per asset, starts at 1
  versionNo    Int
  // Snapshot of the editable fields at publish time
  title        String
  description  String?
  content      String?
  url          String?
  metadata     Json     @default("{}")
  price        Float?
  // Author of this specific version (can differ from current asset author after transfer)
  authorId     String
  // Optional changelog / release notes
  changelog    String?
  createdAt    DateTime @default(now())

  steps        RecipeStep[] @relation("VersionSteps")
  publishedFor Asset?       @relation("AssetPublishedVersion")

  @@unique([assetId, versionNo])
  @@index([assetId])
  @@map("asset_versions")
}

// Recipe step — only used when asset.type = 'Recipe'
model RecipeStep {
  id           String   @id @default(uuid())
  versionId    String
  version      AssetVersion @relation("VersionSteps", fields: [versionId], references: [id], onDelete: Cascade)
  // 1-based ordering
  order        Int
  // Step type: 'prompt' | 'tool_call' | 'http' | 'note'
  kind         String
  title        String
  // Step body — interpreted based on kind
  body         String
  metadata     Json     @default("{}")
  createdAt    DateTime @default(now())

  @@unique([versionId, order])
  @@index([versionId])
  @@map("recipe_steps")
}

// Asset review — user rating + optional comment
model AssetReview {
  id          String   @id @default(uuid())
  assetId     String
  asset       Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // 1..5 stars
  rating      Int
  comment     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([assetId, userId])
  @@index([assetId])
  @@index([userId])
  @@map("asset_reviews")
}

// Asset purchase — append-only transaction log
model AssetPurchase {
  id            String   @id @default(uuid())
  assetId       String
  asset         Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  // versionId the buyer received (denormalized for receipts)
  versionId     String
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Price paid in credits at purchase time (snapshot)
  pricePaid     Float
  // 'completed' | 'refunded'
  status        String   @default("completed")
  // Optional idempotency key
  idempotencyKey String?  @unique
  createdAt     DateTime @default(now())

  @@index([assetId])
  @@index([userId])
  @@index([createdAt])
  @@map("asset_purchases")
}

// Vote model
model Vote {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  assetId   String
  asset     Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  value     Int
  createdAt DateTime @default(now())

  @@unique([userId, assetId])
  @@index([assetId])
  @@map("votes")
}
